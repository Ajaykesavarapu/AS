{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "types": ["node"],
    "rootDir": "../",
    "noEmit": true
  },
  "include": [
    "index.ts",
    "../server/src/**/*.ts",
    "../lib/db/src/**/*.ts",
    "../lib/api-zod/src/**/*.ts"
  ]
}
