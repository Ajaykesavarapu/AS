{
  "buildCommand": "pnpm -r --if-present run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets|Images|favicon.svg|logo.png|robots.txt|sitemap.xml|googlee5f7323937212e3f.html).*)",
      "destination": "/index.html"
    }
  ]
}